{
  "manifest_version": 3,
  "name": "二维码生成器",
  "short_name": "二维码",
  "version": "1.1.0",
  "description": "右键或点击图标快速生成二维码，支持任意文字和页面链接，可编辑后即时生成，纯本地处理，保护隐私。",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "生成二维码",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "omnibox": {
    "keyword": "qr"
  },
  "homepage_url": "https://corle-bell.github.io/QR_Code_Creator/"
}
